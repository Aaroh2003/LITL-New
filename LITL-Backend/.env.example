# Environment variables must be exported by your shell or hosting dashboard.
# No dotenv loader is used. Do not commit your real .env.
AUTH_MODE=local
STORAGE_MODE=local
APP_ENV=local
DATABASE_URL=sqlite:///.data/litl.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosted: all four settings below are mandatory; AUTH_MODE/STORAGE_MODE=supabase,
# APP_ENV=hosted, and exact HTTPS frontend origins in CORS_ORIGINS.
# Supabase dashboard server connection string, URL-encoded password, TLS verification:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=certs/prod-supabase.cer
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-public-publishable-or-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-jwt
# STORAGE_BUCKET=litl-private

# Optional paid/prepaid source connector; empty by default, no fabricated fallback.
# Obtain your own API token/credit from https://api.indiankanoon.org/.
# Enable only after agreeing to terms, permitted retention and authentic logo display.
INDIAN_KANOON_API_TOKEN=
INDIAN_KANOON_TERMS_ACCEPTED=false
