# Local development. For a hosted build, set your real HTTPS Render API origin.
# Do not use localhost in a deployed frontend; configuration will be rejected.
VITE_API_URL=http://127.0.0.1:8000
# Supabase URL and browser publishable key come from GET /v1/config.
# Never place a service-role key or source-provider credential in VITE_* variables.
